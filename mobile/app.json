{
  "expo": {
    "name": "RunUp",
    "slug": "runup-corridas",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "runup",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0A12",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.runup.corridas",
      "supportsTablet": false,
      "infoPlist": {
        "LSApplicationQueriesSchemes": ["instagram", "instagram-stories", "whatsapp"],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.runup.corridas",
      "adaptiveIcon": {
        "backgroundColor": "#0A0A12",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0A12",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Usamos suas fotos para montar o post do seu treino e personalizar a corrida.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Permite salvar a arte do seu treino na galeria.",
          "savePhotosPermission": "Permite salvar a arte do seu treino na galeria.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": ["photo"]
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    },
    "extra": {
      "eas": {}
    }
  }
}
